    {
      "id": "no-new-truth",
      "type": "text",
      "x": 950,
      "y": 70,
      "width": 290,
      "height": 220,
      "text": "# No-New-Truth\nOutput Facts ⊆ Bundle Facts\nOutput Claims ⊆ Bundle Claims\nOutput Decisions ⊆ Bundle Decisions\nJede sichtbare Zahl besitzt Lineage",
      "color": "1"
    },
    {
      "id": "ops",

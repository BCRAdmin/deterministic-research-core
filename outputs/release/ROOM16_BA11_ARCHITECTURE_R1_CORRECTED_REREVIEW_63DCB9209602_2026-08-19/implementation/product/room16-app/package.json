{
  "name": "room16-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs --dev --port 4516",
    "build": "node scripts/room16_locked_build.mjs",
    "start": "node server.mjs --static --port 4516",
    "lint": "tsc -b --pretty false",
    "verify": "node scripts/verify_room16_app.mjs && node --test scripts/test_current_research_error.mjs scripts/test_research_authority_resolver.mjs scripts/test_deterministic_research_report.mjs scripts/test_internal_review_evidence.mjs scripts/test_private_beta_contract.mjs scripts/test_paid_delivery.mjs && node scripts/verify_valuation_calibration_status.mjs && npm run verify:authority-bindings && npm run verify:compiler-artifact-bundle && npm run verify:canary-registry-mirror",
    "verify:golden-standard": "cd .. && .venv/bin/python -m pytest -q tests/test_golden_standard_quality.py tests/test_yfinance_date_contract.py tests/test_institutional_quality.py tests/test_room16_text_safety.py tests/test_structured_agents.py tests/test_room16_lifecycle.py",
    "verify:dependency-audit": "npm audit --omit=dev --audit-level=high && cd .. && .venv/bin/pip-audit --local --skip-editable",
    "verify:layout": "node scripts/verify_mobile_layout.mjs",
    "verify:report-machine": "node scripts/verify_room16_report_machine.mjs",
    "verify:api-guard": "node scripts/verify_mutating_api_guard.mjs",
    "verify:german-output-quality": "node scripts/verify_german_output_quality.mjs",
    "verify:symbol-resolver": "node --test scripts/test_symbol_resolver.mjs",
    "verify:market-capabilities": "node --test scripts/test_market_capability_snapshot.mjs scripts/test_adapter_readiness.mjs && node scripts/verify_market_capability_snapshot.mjs",
    "verify:authority-resolver": "node --test scripts/test_research_authority_resolver.mjs",
    "verify:authority-bindings": "cd .. && PYTHONPATH=. .venv/bin/python scripts/room16_audit_authority_bindings.py",
    "verify:compiler-foundation": "node --test scripts/test_compiler_foundation_mirror.mjs && node scripts/verify_compiler_foundation_mirror.mjs",
    "verify:semantic-registry": "node --test scripts/test_semantic_registry_mirror.mjs && node scripts/verify_semantic_registry_mirror.mjs",
    "verify:compiler-artifact-bundle": "node --test scripts/test_compiler_artifact_bundle.mjs && node scripts/verify_product_truth_boundary.mjs && node scripts/verify_compiler_artifact_trust_api.mjs",
    "verify:compiler-artifact-trust-api": "node scripts/verify_compiler_artifact_trust_api.mjs",
    "verify:canary-registry-mirror": "node --test scripts/test_canary_registry_mirror.mjs",
    "verify:authority-interpretation": "cd .. && .venv/bin/python -m pytest -q tests/test_authority_interpretation_contract.py tests/test_authority_interpretation_reporting.py tests/test_room16_graph_contract.py tests/test_checkpoint_resume.py tests/test_memory_log.py tests/test_room16_model_qualification.py",
    "verify:release-evidence": "python3 ../scripts/room16_release_evidence.py --self-test",
    "verify:public-gate": "node scripts/verify_public_gate_contract.mjs",
    "verify:public-legal-review": "node --test scripts/test_public_legal_review_evidence.mjs",
    "verify:publication-handoff": "node --test scripts/test_publication_handoff.mjs",
    "verify:paid-product": "cd .. && .venv/bin/python -m pytest -q tests/test_room16_paid_report_renderer.py tests/test_room16_paid_product_contract.py",
    "verify:commerce-contract": "cd .. && .venv/bin/python -m pytest -q tests/test_room16_commerce_contract.py",
    "verify:checkout-gateway": "node --test scripts/test_checkout_gateway.mjs && cd .. && .venv/bin/python -m pytest -q tests/test_room16_checkout_gateway.py",
    "verify:payment-webhook": "node --test scripts/test_payment_webhook.mjs && cd .. && .venv/bin/python -m pytest -q tests/test_room16_payment_webhook_gateway.py",
    "verify:customer-portal": "node --test scripts/test_customer_portal_gateway.mjs && cd .. && .venv/bin/python -m pytest -q tests/test_room16_customer_portal_gateway.py",
    "verify:customer-operation-gateway": "node --test scripts/test_customer_operation_webhook.mjs && cd .. && .venv/bin/python -m pytest -q tests/test_room16_customer_operation_gateway.py",
    "verify:sales-activation-pack": "cd .. && .venv/bin/python -m pytest -q tests/test_room16_sales_activation_pack.py",
    "verify:customer-access-ui": "node --test ../room16-customer-access/test_portal_contract.mjs && node ../room16-customer-access/verify.mjs && node ../room16-customer-access/build.mjs",
    "verify:p4-technical-closure": "npm run verify:customer-access-ui && cd .. && .venv/bin/python -m pytest -q tests/test_room16_p4_technical_closure.py && .venv/bin/python scripts/room16_p4_technical_closure.py",
    "verify:p5-technical-closure": "cd ../../research-agent-ops && .venv/bin/python -m pytest -q research_agent/tests/test_p5_technical_closure.py && .venv/bin/python -m research_agent.ops.p5_technical_closure",
    "verify:p6-technical-closure": "cd ../../research-agent-ops && .venv/bin/python -m pytest -q research_agent/tests/test_p6_technical_closure.py && .venv/bin/python -m research_agent.ops.p6_technical_closure",
    "verify:p1-p6-technical-closure": "node --test scripts/test_p1_p6_technical_closure.mjs && node scripts/verify_p1_p6_technical_closure.mjs",
    "build:human-verification-package": "cd .. && .venv/bin/python scripts/room16_build_human_verification_package.py",
    "verify:human-verification-package": "cd .. && .venv/bin/python scripts/room16_verify_human_verification_package.py --package .runtime/room16-app/human-verification/room16-p1-p6-human-verification-2026-08-10",
    "verify:entitlement-ledger": "cd .. && .venv/bin/python -m pytest -q tests/test_room16_entitlement_ledger.py",
    "verify:entitlement-version-access": "cd .. && .venv/bin/python -m pytest -q tests/test_room16_entitlement_version_access.py",
    "verify:product-version-registry": "cd .. && .venv/bin/python -m pytest -q tests/test_room16_product_version_registry.py",
    "verify:delivery-access": "cd .. && .venv/bin/python -m pytest -q tests/test_room16_delivery_access.py",
    "verify:delivery-http": "node --test scripts/test_paid_delivery.mjs",
    "verify:customer-operations": "cd .. && .venv/bin/python -m pytest -q tests/test_room16_customer_operations.py",
    "verify:paid-operations-readiness": "cd .. && .venv/bin/python -m pytest -q tests/test_room16_delivery_access.py tests/test_room16_customer_operations.py",
    "verify:manual-review-workbench": "node scripts/verify_manual_review_workbench.mjs",
    "verify:review-gate-status": "node scripts/verify_review_gate_status.mjs",
    "verify:manual-review-packets": "node scripts/build_manual_review_packets.mjs",
    "verify:review-state": "npm run verify:review-gate-status && npm run verify:manual-review-packets && npm run verify:publish-readiness",
    "verify:manual-review-packet-roots": "node scripts/build_manual_review_packets.mjs --self-test",
    "verify:internal-review": "node scripts/verify_internal_review_evidence.mjs",
    "verify:private-beta-backup": "node scripts/room16_private_beta_backup.mjs --self-test",
    "verify:private-beta": "node scripts/verify_private_beta_candidate.mjs",
    "verify:publish-readiness": "node scripts/verify_publish_readiness.mjs",
    "verify:review-operations": "node scripts/verify_review_operations_runbook.mjs",
    "clean:dry": "bash ../scripts/clean_room16_runtime_artifacts.sh",
    "clean:runtime": "bash ../scripts/clean_room16_runtime_artifacts.sh --apply",
    "clean:reports": "bash ../scripts/clean_room16_runtime_artifacts.sh --apply --prune-reports",
    "clean:retention:dry": "bash ../scripts/clean_room16_runtime_artifacts.sh --skip-build-artifacts --prune-runtime",
    "clean:retention:safe": "bash ../scripts/run_room16_safe_retention_apply.sh",
    "hardening:once": "node scripts/room16_night_hardening_loop.mjs --cycles 1 --retain-cycles 20",
    "hardening:loop": "node scripts/room16_night_hardening_loop.mjs --cycles 3 --interval-ms 120000 --retain-cycles 20"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "express": "^4.21.2",
    "lucide-react": "^0.561.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@types/node": "^25.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "qs": "6.15.2"
  }
}

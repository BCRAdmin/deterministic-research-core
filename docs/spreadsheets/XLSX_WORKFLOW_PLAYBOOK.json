{
  "name": "XLSX Workflow Playbook",
  "status": "active_draft",
  "scope": "Room16/Quellwert/Utility/Data Ops tables",
  "risk_class": "R2_local_write_within_project",
  "runtime_changes": "none",
  "purpose": "Handle XLSX as controlled workbook artifacts with formula, format and schema validation.",
  "use_cases": [
    "read_xlsx_workbook",
    "validate_data_and_schema",
    "create_result_or_audit_workbook",
    "export_batch_outcome_guardrail_matrices",
    "preserve_formulas"
  ],
  "rules": [
    "never_overwrite_original",
    "detect_and_preserve_formula_cells",
    "check_datatypes_before_writing",
    "check_date_currency_percentage_formats",
    "inspect_hidden_sheets",
    "document_pivots_and_charts",
    "do_not_blindly_mutate_pivots_or_charts",
    "avoid_libreoffice_pdf_paths_without_specific_reason",
    "record_type_coercion_risk"
  ],
  "required_artifacts": [
    "input_summary.md",
    "schema_profile.json",
    "validation_report.md",
    "output.xlsx",
    "changelog.md"
  ],
  "validation": [
    "workbook_opens",
    "sheet_count_matches_expectation",
    "row_column_sanity",
    "formula_cells_preserved_or_documented",
    "date_number_formats_preserved",
    "no_silent_type_coercion",
    "hidden_sheets_and_protection_reported"
  ],
  "room16_quellwert_use_cases": [
    "outcome_review_xlsx",
    "guardrail_coverage_matrix_xlsx",
    "data_ops_backlog_xlsx",
    "utility_gsc_event_review_xlsx"
  ],
  "forbidden": [
    "blind_formula_overwrite",
    "csv_roundtrip_as_safe_xlsx_editing",
    "drop_hidden_sheets_without_review",
    "claim_workbook_validation_from_cell_reads_alone",
    "publish_or_send_without_operator_approval"
  ]
}

{
  "name": "DOCX Workflow Playbook",
  "status": "active_draft",
  "scope": "LIONCOM/Vega/Vivi document workflows",
  "risk_class": "R2_local_write_within_project",
  "runtime_changes": "none",
  "purpose": "Handle DOCX as controlled artifacts with source preservation, reviewable changes and validation.",
  "use_cases": [
    "read_word_document",
    "create_word_document_from_markdown",
    "create_review_or_redline_summary",
    "prepare_pdf_ready_docx",
    "verify_no_hidden_changes"
  ],
  "rules": [
    "never_overwrite_original",
    "always_create_copy_or_new_output",
    "document_material_changes",
    "check_tables_images_footnotes_headers_footers_lists_page_breaks",
    "do_not_embed_or_export_fonts_without_operator_instruction",
    "check_metadata_risk",
    "document_output_paths",
    "no_final_claim_without_validation"
  ],
  "required_artifacts": [
    "source_file",
    "working_copy.docx",
    "extracted_text.md",
    "change_summary.md",
    "output.docx",
    "validation_report.md"
  ],
  "validation": [
    "file_opens_without_repair_prompt",
    "page_structure_plausible",
    "tables_preserved",
    "images_present",
    "footnotes_headers_footers_preserved",
    "no_unexpected_empty_pages",
    "unicode_umlauts_render",
    "metadata_risk_checked"
  ],
  "vivi_review": [
    "layout_risk",
    "content_drift_risk",
    "missing_validation_evidence",
    "metadata_export_risk",
    "final_language_justified"
  ],
  "forbidden": [
    "overwrite_only_source_copy",
    "hide_tracked_changes_without_instruction",
    "treat_text_extraction_as_layout_validation",
    "send_or_publish_generated_document",
    "convert_without_explicit_operator_input"
  ]
}

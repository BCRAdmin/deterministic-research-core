{
  "name": "Agent-OS-Readiness-Paket",
  "status": "active_local_v1",
  "runtime_changes": "none",
  "command": "python3 scripts/ops/agent_os_readiness.py",
  "outputs": [
    "outputs/agent_os_readiness/AGENT_OS_READINESS_REPORT.md",
    "outputs/agent_os_readiness/SKILL_REGISTRY.md",
    "outputs/agent_os_readiness/MEMORY_INBOX_CANDIDATES.md",
    "outputs/agent_os_readiness/SESSION_SEARCH.sqlite",
    "outputs/agent_os_readiness/AUTOMATION_JOB_CARDS.md",
    "outputs/agent_os_readiness/DELIVERABLE_SWARM_CONTRACT.md",
    "outputs/agent_os_readiness/OPERATOR_INBOX.md",
    "outputs/agent_os_readiness/TERMINAL_BACKENDS.md",
    "outputs/agent_os_readiness/GUARDRAIL_SCAN.md",
    "outputs/agent_os_readiness/RUN_SUMMARY.json"
  ],
  "boundaries": [
    "no_external_skill_install",
    "no_secret_value_import",
    "no_runtime_config_mutation",
    "no_obsidian_autowrite",
    "no_automation_creation",
    "no_network_calls",
    "no_unbounded_all_to_all_handoff",
    "no_auto_provider_runtime"
  ],
  "gates": [
    "External Skill Intake SOP",
    "Operator-Gate fuer R3+-Runtime-Verhalten",
    "Obsidian-Promotion-Review fuer dauerhaftes Memory",
    "Sandbox-Plan vor Desktop-/Browser-/Gateway-Erweiterung",
    "Deliverable-Swarm-Vertrag vor sichtbarer Lane-Erweiterung"
  ]
}

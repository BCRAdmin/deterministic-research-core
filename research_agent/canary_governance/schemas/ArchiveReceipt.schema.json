{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "archive_content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Archive Content Sha256",
      "type": "string"
    },
    "archive_contract_version": {
      "const": 1,
      "default": 1,
      "title": "Archive Contract Version",
      "type": "integer"
    },
    "archive_member_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Archive Member Manifest Sha256",
      "type": "string"
    },
    "authority_owner": {
      "const": "research",
      "default": "research",
      "title": "Authority Owner",
      "type": "string"
    },
    "contract_id": {
      "const": "room16.canary_archive_receipt",
      "default": "room16.canary_archive_receipt",
      "title": "Contract Id",
      "type": "string"
    },
    "receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Sha256",
      "type": "string"
    },
    "retention_class": {
      "enum": [
        "permanent_evidence",
        "governance_record"
      ],
      "title": "Retention Class",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_date_epoch": {
      "minimum": 315532800,
      "title": "Source Date Epoch",
      "type": "integer"
    },
    "supersedes_archive_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Archive Sha256"
    }
  },
  "required": [
    "archive_content_sha256",
    "archive_member_manifest_sha256",
    "source_date_epoch",
    "retention_class",
    "receipt_sha256"
  ],
  "title": "ArchiveReceipt",
  "type": "object",
  "x-room16-canonicalization": "room16.canonical_json@1",
  "x-room16-hash-algorithm": "sha256",
  "x-room16-unknown-field-policy": "fail_closed"
}

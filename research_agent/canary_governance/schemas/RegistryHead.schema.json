{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_owner": {
      "const": "research",
      "default": "research",
      "title": "Authority Owner",
      "type": "string"
    },
    "consumed_nonce_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Consumed Nonce Set Sha256",
      "type": "string"
    },
    "contract_id": {
      "const": "room16.canary_registry_head",
      "default": "room16.canary_registry_head",
      "title": "Contract Id",
      "type": "string"
    },
    "debt_ledger_head_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Debt Ledger Head Sha256",
      "type": "string"
    },
    "head_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Head Sha256",
      "type": "string"
    },
    "operator_counter": {
      "minimum": 0,
      "title": "Operator Counter",
      "type": "integer"
    },
    "previous_head_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Head Sha256"
    },
    "registry_generation": {
      "minimum": 0,
      "title": "Registry Generation",
      "type": "integer"
    },
    "registry_ledger_head_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Registry Ledger Head Sha256",
      "type": "string"
    },
    "reviewer_counter": {
      "minimum": 0,
      "title": "Reviewer Counter",
      "type": "integer"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Sha256",
      "type": "string"
    },
    "transaction_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Transaction Sha256",
      "type": "string"
    }
  },
  "required": [
    "registry_generation",
    "snapshot_sha256",
    "registry_ledger_head_sha256",
    "debt_ledger_head_sha256",
    "transaction_sha256",
    "consumed_nonce_set_sha256",
    "operator_counter",
    "reviewer_counter",
    "head_sha256"
  ],
  "title": "RegistryHead",
  "type": "object",
  "x-room16-canonicalization": "room16.canonical_json@1",
  "x-room16-hash-algorithm": "sha256",
  "x-room16-unknown-field-policy": "fail_closed"
}
